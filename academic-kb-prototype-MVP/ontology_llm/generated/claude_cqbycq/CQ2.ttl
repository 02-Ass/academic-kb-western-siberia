@prefix : <http://example.org/westsib#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Publication a owl:Class ;
    rdfs:label "Publication"@en, "Публикация"@ru ;
    rdfs:comment "A scientific publication."@en .

:GeologicalObject a owl:Class ;
    rdfs:label "GeologicalObject"@en, "Геологический объект"@ru ;
    rdfs:comment "Any spatial object of the hierarchy."@en .

:District a owl:Class ;
    rdfs:label "District"@en, "Нефтегазоносный район"@ru ;
    rdfs:comment "Petroleum district."@en ;
    rdfs:subClassOf :GeologicalObject .

:Field a owl:Class ;
    rdfs:label "Field"@en, "Месторождение"@ru ;
    rdfs:comment "Oil and gas field."@en ;
    rdfs:subClassOf :GeologicalObject .

:Horizon a owl:Class ;
    rdfs:label "Horizon"@en, "Пласт"@ru ;
    rdfs:comment "Productive horizon."@en ;
    rdfs:subClassOf :GeologicalObject .

:Deposit a owl:Class ;
    rdfs:label "Deposit"@en, "Залежь"@ru ;
    rdfs:comment "Hydrocarbon deposit."@en ;
    rdfs:subClassOf :GeologicalObject .

:partOf a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "part of"@en, "входит в"@ru ;
    rdfs:comment "A geological object is part of a larger one."@en ;
    rdfs:domain :GeologicalObject ;
    rdfs:range :GeologicalObject .

:isAbout a owl:ObjectProperty ;
    rdfs:label "is about"@en, "относится к"@ru ;
    rdfs:comment "Links a publication to a geological object. Propagates upwards along partOf."@en ;
    rdfs:domain :Publication ;
    rdfs:range :GeologicalObject ;
    owl:propertyChainAxiom ( :isAbout :partOf ) .
