@prefix : <http://example.org/westsib#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Publication a owl:Class ;
    rdfs:label "Publication"@en, "Публикация"@ru ;
    rdfs:comment "A scientific publication."@en .

:title a owl:DatatypeProperty ;
    rdfs:label "title"@en, "название"@ru ;
    rdfs:comment "Title."@en ;
    rdfs:domain :Publication ;
    rdfs:range xsd:string .

:doi a owl:DatatypeProperty ;
    rdfs:label "doi"@en, "DOI"@ru ;
    rdfs:comment "Digital Object Identifier."@en ;
    rdfs:domain :Publication ;
    rdfs:range xsd:string .

:url a owl:DatatypeProperty ;
    rdfs:label "url"@en, "ссылка"@ru ;
    rdfs:comment "Link to the publication."@en ;
    rdfs:domain :Publication ;
    rdfs:range xsd:anyURI .

