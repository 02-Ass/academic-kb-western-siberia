@prefix : <http://example.org/westsib#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Field a owl:Class ;
    rdfs:label "Field"@en, "Месторождение"@ru ;
    rdfs:comment "Oil and gas field."@en .

:District a owl:Class ;
    rdfs:label "District"@en, "Район"@ru ;
    rdfs:comment "Petroleum district."@en .

:partOf a owl:ObjectProperty ;
    rdfs:label "part of"@en, "входит в"@ru ;
    rdfs:comment "A field belongs to a district."@en ;
    rdfs:domain :Field ;
    rdfs:range :District .
