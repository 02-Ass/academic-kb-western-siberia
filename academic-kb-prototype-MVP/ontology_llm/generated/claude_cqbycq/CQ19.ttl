@prefix : <http://example.org/westsib#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Publication a owl:Class ;
    rdfs:label "Publication"@en, "Публикация"@ru ;
    rdfs:comment "A scientific publication."@en .

:GeologicalObject a owl:Class ;
    rdfs:label "GeologicalObject"@en, "Геологический объект"@ru ;
    rdfs:comment "Any object of the hierarchy."@en .

:isAbout a owl:ObjectProperty ;
    rdfs:label "is about"@en, "относится к"@ru ;
    rdfs:domain :Publication ;
    rdfs:range :GeologicalObject .

:MultiObjectPublication a owl:Class ;
    rdfs:label "Multi-object publication"@en, "Публикация о нескольких объектах"@ru ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :isAbout ; owl:minCardinality "2"^^xsd:nonNegativeInteger ] ;
    rdfs:subClassOf :Publication .
