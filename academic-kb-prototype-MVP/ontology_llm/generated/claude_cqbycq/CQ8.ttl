@prefix : <http://example.org/westsib#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Publication a owl:Class ;
    rdfs:label "Publication"@en, "Публикация"@ru ;
    rdfs:comment "A scientific publication."@en .

:ResearchType a owl:Class ;
    rdfs:label "ResearchType"@en, "Тип исследования"@ru ;
    rdfs:comment "Kind of research."@en .

:hasResearchType a owl:ObjectProperty ;
    rdfs:label "has research type"@en, "относится к типу исследования"@ru ;
    rdfs:domain :Publication ;
    rdfs:range :ResearchType .
