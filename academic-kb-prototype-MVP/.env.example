# Скопируйте этот файл в .env и впишите один из ключей ниже.
# .env НИКОГДА не должен попадать в git / отправляться кому-либо —
# он только для локального использования на вашей машине.
#
# Задайте ОДИН из следующих ключей (backend сам найдёт заданный):
#
# DeepSeek (платный, но очень дёшево) — https://platform.deepseek.com
# DEEPSEEK_API_KEY=впишите-сюда-свой-ключ
#
# Groq — бесплатно, без карты — https://console.groq.com/keys
# GROQ_API_KEY=впишите-сюда-свой-ключ
#
# Google Gemini — бесплатно, без карты — https://aistudio.google.com/apikey
# GEMINI_API_KEY=впишите-сюда-свой-ключ

# GROQ_API_KEY=впишите-сюда-свой-настоящий-ключ

# Если не хотите настоящий LLM — просто не создавайте .env вообще,
# или оставьте переменные пустыми: backend автоматически откатится
# на шаблонную сборку ответов (app/search.py:_build_template_answer).


# ----- Внешний поиск публикаций -----
# OpenAlex: бесплатный ключ https://openalex.org/settings/api (без ключа дневной лимит поиска очень мал)
# OPENALEX_API_KEY=
# OPENALEX_EMAIL=ваш-email@example.com
# CROSSREF_EMAIL=ваш-email@example.com

# ----- Смысловой поиск (необязательно) -----
# Любой сервис с OpenAI-совместимым методом /embeddings. Пример для Google Gemini
# (слой совместимости у Google описан как бета; на бесплатном тарифе есть лимит запросов в минуту):
# EMBEDDINGS_API_KEY=ключ-Gemini
# EMBEDDINGS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBEDDINGS_MODEL=gemini-embedding-001
# Порог схожести: подберите командой  python -m scripts.eval_chat calibrate
# EMBEDDINGS_MIN_SIM=0.55

# ----- Онтология -----
# По умолчанию структура онтологии берётся из data/oil-gas-ontology.owl (ваш файл из Protégé, Turtle или RDF/XML).
# Другой файл:
# ONTOLOGY_FILE=C:\путь\к\онтологии.owl

# ----- Классификатор темы вопроса и журнал (v29) -----
# Если задан EMBEDDINGS_API_KEY, тема вопроса определяется по близости к эталонным фразам предметной области.
# Пороги зависят от модели эмбеддингов — подберите: python -m scripts.eval_chat scope --fast
# SCOPE_EMBED=1            # 0 — не использовать эмбеддинги для темы (останутся ключевые слова и LLM)
# SCOPE_SIM_HIGH=0.50      # близость >= HIGH — «по теме»
# SCOPE_SIM_LOW=0.35       # близость <= LOW — «вне темы»; между порогами решают ключевые слова и LLM
# SCOPE_METHOD=centroid    # centroid | top3
# Кэш переписанных запросов и классификации в памяти (число записей; 0 — выключить):
# LLM_CACHE_SIZE=1000
# Журнал запросов: logs/chat_logs.jsonl (по строке JSON на запрос). CHAT_LOG=0 — выключить.
# CHAT_LOG=1
# CHAT_LOG_PATH=logs/chat_logs.jsonl

# ----- База данных -----
# Без этой строки используется SQLite-файл kb.db (в нём только 5 демо-публикаций). Для рабочей базы PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:ПАРОЛЬ@localhost:5432/academic_dpm
